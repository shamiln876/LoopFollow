{
  "name": "loopfollow-private-plate-scanner",
  "main": "worker.mjs",
  "compatibility_date": "2025-10-01",
  "observability": {"enabled": false},
  "durable_objects": {"bindings": [{"name": "SCAN_BUDGET", "class_name": "ScanBudget"}]},
  "migrations": [{"tag": "scan-budget-v1", "new_sqlite_classes": ["ScanBudget"]}],
  "unsafe": {"bindings": [{"name": "RATE_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": {"limit": 5, "period": 60}}]}
}
